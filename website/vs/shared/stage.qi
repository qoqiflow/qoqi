impl Flow<Outcome> for Expense {
    fn run() -> Outcome {
        notifyManager(self.id);
        let answer = wait self.answers.receive();

        // Running instances move to new code here, and only here
        stage paying;

        notifyAccounting(self.id);      // new in version 2
        return pay(self.employee, self.cents);
    }
}

