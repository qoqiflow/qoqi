import game.physics.collide.{Shape};

pub struct Body {
    x: Int;
    size: Int;
}

impl Shape for Body {
    fn left() -> Int {
        return self.x;
    }

    fn right() -> Int {
        return self.x + self.size;
    }
}

impl Body {
    pub fn move(by: Int) {
        self.x += by;
    }
}

pub fn new(x: Int, size: Int) -> Body {
    return Body { x: x, size: atLeastOne(size) };
}

fn atLeastOne(size: Int) -> Int {
    if size < 1 {
        return 1;
    }

    return size;
}
