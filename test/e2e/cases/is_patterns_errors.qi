// Each of these tests a value against a pattern it can never fit, or one
// it always fits.

enum Shape { Circle(Float), Rect(Float, Float), Empty }

enum Light { Red, Green }

enum Wrap { Of(Int) }

fn unknown(shape: Shape) -> Bool {
    return shape is Shape.Square(_);
}

fn count(shape: Shape) -> Float {
    if shape is Shape.Rect(w) {
        return w;
    }

    return 0.0;
}

fn other(shape: Shape) -> Bool {
    return shape is Light.Red;
}

fn number(n: Int) -> Bool {
    return n is Shape.Empty;
}

fn literal(shape: Shape) -> Bool {
    return shape is Shape.Circle("wide");
}

fn size(pair: (Int, Int)) -> Int {
    if pair is (a, b, c) {
        return a;
    }

    return 0;
}

fn wrong(shape: Shape) -> Int {
    if shape is Shape.Circle(r) && r > "1" {
        return 1;
    }

    return 0;
}

fn always(wrap: Wrap, pair: (Int, Int)) -> Int {
    if wrap is Wrap.Of(n) {
        return n;
    }

    if pair is (a, b) {
        return a + b;
    }

    return 0;
}

fn main() -> Int {
    return 0;
}
