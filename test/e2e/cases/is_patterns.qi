// `value is Pattern`: one variant of an enum taken apart where a whole
// match would say more than is meant. A small machine that runs a list of
// instructions, and reports on what it ran.

enum Value { Number(Int), Text(String), Pair(Value, Value), Nothing }

enum Step { Push(Value), Add, Join, Swap, Jump(Int), JumpIfZero(Int), Print, Halt }

enum Option<T> { Some(T), None }

struct Machine {
    stack: [Value];
    at: Int;
    printed: [String];
    ran: Int;
}

impl Machine {
    fn pop() -> Option<Value> {
        let size = self.stack.len();

        if size == 0 {
            return Option.None;
        }

        let top = self.stack[size - 1];
        self.stack = self.stack.slice(0, size - 1);
        return Option.Some(top);
    }

    // The two values on top, the one pushed first on the left
    fn two() -> Option<(Value, Value)> {
        if self.pop() is Option.Some(right) && self.pop() is Option.Some(left) {
            return Option.Some((left, right));
        }

        return Option.None;
    }

    fn step(steps: [Step]) -> Result<Bool, String> {
        if self.at >= steps.len() {
            return Ok(false);
        }

        let step = steps[self.at];
        self.at += 1;
        self.ran += 1;

        if step is Step.Halt {
            return Ok(false);
        } else if step is Step.Push(value) {
            self.stack.push(value);
        } else if step is Step.Jump(to) {
            self.at = to;
        } else if step is Step.JumpIfZero(to) {
            if self.pop() is Option.Some(Value.Number(0)) {
                self.at = to;
            }
        } else if step is Step.Print {
            if self.pop() is Option.Some(value) {
                self.printed.push(show(value));
            } else {
                return Err("nothing to print");
            }
        } else if self.two() is Option.Some((left, right)) {
            if step is Step.Add && left is Value.Number(a) && right is Value.Number(b) {
                self.stack.push(Value.Number(a + b));
            } else if step is Step.Join {
                self.stack.push(Value.Text(show(left) + show(right)));
            } else if step is Step.Swap {
                self.stack.push(right);
                self.stack.push(left);
            } else {
                return Err("cannot add ${show(left)} and ${show(right)}");
            }
        } else {
            return Err("two values are needed");
        }

        return Ok(true);
    }
}

fn show(value: Value) -> String {
    if value is Value.Number(n) {
        return toString(n);
    }

    if value is Value.Text(text) {
        return text;
    }

    if value is Value.Pair(first, second) {
        return "(${show(first)}, ${show(second)})";
    }

    return "nothing";
}

fn run(steps: [Step]) -> Machine {
    let machine = Machine { stack: [], at: 0, printed: [], ran: 0 };
    let outcome = machine.step(steps);

    while outcome is Ok(true) && machine.ran < 100 {
        outcome = machine.step(steps);
    }

    if outcome is Err(reason) {
        machine.printed.push("failed: " + reason);
    }

    return machine;
}

// The numbers a value holds, however deep
fn numbers(value: Value, into: [Int]) {
    if value is Value.Number(n) {
        into.push(n);
    } else if value is Value.Pair(first, second) {
        numbers(first, into);
        numbers(second, into);
    }
}

fn main() -> Int {
    // Takes one from 3 and says what is left
    let countdown = [
        Step.Push(Value.Number(3)),
        Step.Push(Value.Number(-1)),
        Step.Add,
        Step.Push(Value.Text("left ")),
        Step.Swap,  // the text goes under the number
        Step.Join,
        Step.Print,
        Step.Halt,
    ];

    println(run(countdown).printed);

    let failing = [Step.Push(Value.Text("a")), Step.Push(Value.Number(1)), Step.Add, Step.Print];
    println(run(failing).printed);
    println(run([Step.Print]).printed, run([Step.Add]).printed);

    // A jump taken only when a zero is on top
    let jumping = [
        Step.Push(Value.Number(0)),
        Step.JumpIfZero(4),
        Step.Push(Value.Text("skipped")),
        Step.Print,
        Step.Push(Value.Number(7)),
        Step.JumpIfZero(0),
        Step.Push(Value.Text("done")),
        Step.Print,
    ];

    let machine = run(jumping);
    println(machine.printed, machine.ran);

    // Tests as values, and in the functions handed to the library
    let steps = countdown.concat(jumping);
    let pushes = steps.filter(step -> step is Step.Push(_));

    let texts = steps.filter(step -> step is Step.Push(Value.Text(text)) && text.len() > 4);

    let jumpsBack = steps.filter(
        step -> step is Step.Jump(to) && to == 0 || step is Step.JumpIfZero(0),
    );

    println(
        pushes.len(),
        texts.len(),
        jumpsBack.len(),
        steps[2] is Step.Add,
        !(steps[0] is Step.Halt),
    );

    // Each closure keeps the value its pattern named
    let later: [fn() -> String] = [];

    for step in steps {
        if step is Step.Push(value) && !(value is Value.Number(_)) {
            later.push(() -> "pushes ${show(value)}");
        }
    }

    for each in later {
        println(each());
    }

    let nested = Value.Pair(
        Value.Number(1),
        Value.Pair(Value.Text("x"), Value.Pair(Value.Number(2), Value.Nothing)),
    );

    let found: [Int] = [];
    numbers(nested, found);
    println(found, show(nested));

    // A tuple is taken apart the same way; so is a value that may be null
    let pair = (nested, 2);

    if pair is (Value.Pair(Value.Number(first), _), count) && count > first {
        println(first, count);
    }

    let maybe: Value? = null;

    if maybe is Value.Number(n) {
        println(n);
    } else {
        println("null is no number");
    }

    maybe = Value.Number(5);

    if maybe is Value.Number(n) {
        println(n, show(maybe));
    }

    return 0;
}
