// A document as a tree of values, built, searched, changed and printed.
//
// An enum that holds arrays of itself, a struct holding the enum, generic
// enums for results, constants, and the standard library around them.

const INDENT = "  ";
const MAX_DEPTH = 3;

enum Json {
    Null,
    Bool(Bool),
    Number(Int),
    String(String),
    Array([Json]),
    Object([Member]),
}

struct Member {
    key: String;
    value: Json;
}

enum Option<T> { Some(T), None }

enum Lookup { Found(Json), NoSuchKey(String), NotAnObject }

fn member(key: String, value: Json) -> Member {
    return Member { key: key, value: value };
}

impl Json {
    fn kind() -> String {
        match self {
            case Json.Null: {
                return "null";
            }

            case Json.Bool(_): {
                return "bool";
            }

            case Json.Number(_): {
                return "number";
            }

            case Json.String(_): {
                return "string";
            }

            case Json.Array(_): {
                return "array";
            }

            case Json.Object(_): {
                return "object";
            }
        }
    }

    // On one line.
    fn compact() -> String {
        match self {
            case Json.Null: {
                return "null";
            }

            case Json.Bool(true): {
                return "true";
            }

            case Json.Bool(false): {
                return "false";
            }

            case Json.Number(n): {
                return toString(n);
            }

            case Json.String(text): {
                return "\"" + text + "\"";
            }

            case Json.Array(items): {
                return "["
                    + items.map(fn(j: Json) -> String {
                        return j.compact();
                    }).join(",")
                    + "]";
            }

            case Json.Object(members): {
                let parts = members.map(fn(m: Member) -> String {
                    return "\"" + m.key + "\":" + m.value.compact();
                });

                return "{" + parts.join(",") + "}";
            }
        }
    }

    // Over several lines; what is deeper than MAX_DEPTH stays on one.
    fn pretty(depth: Int) -> String {
        let pad = INDENT.repeat(depth + 1);
        let close = INDENT.repeat(depth);

        match self {
            case Json.Array(items): {
                if items.len() == 0 || depth >= MAX_DEPTH {
                    return self.compact();
                }

                let lines = items.map(fn(j: Json) -> String {
                    return pad + j.pretty(depth + 1);
                });

                return "[\n" + lines.join(",\n") + "\n" + close + "]";
            }

            case Json.Object(members): {
                if members.len() == 0 || depth >= MAX_DEPTH {
                    return self.compact();
                }

                let lines = members.map(fn(m: Member) -> String {
                    return pad + "\"" + m.key + "\": " + m.value.pretty(depth + 1);
                });

                return "{\n" + lines.join(",\n") + "\n" + close + "}";
            }

            default: {
                return self.compact();
            }
        }
    }

    fn get(key: String) -> Lookup {
        match self {
            case Json.Object(members): {
                for m in members {
                    if m.key == key {
                        return Lookup.Found(m.value);
                    }
                }

                return Lookup.NoSuchKey(key);
            }

            default: {
                return Lookup.NotAnObject;
            }
        }
    }

    // How many values the tree holds, itself included.
    fn count() -> Int {
        match self {
            case Json.Array(items): {
                return items.fold(1, fn(n: Int, j: Json) -> Int {
                    return n + j.count();
                });
            }

            case Json.Object(members): {
                return members.fold(1, fn(n: Int, m: Member) -> Int {
                    return n + m.value.count();
                });
            }

            default: {
                return 1;
            }
        }
    }

    // The sum of every number in the tree.
    fn total() -> Int {
        match self {
            case Json.Number(n): {
                return n;
            }

            case Json.Array(items): {
                return items.map(fn(j: Json) -> Int {
                    return j.total();
                }).sum();
            }

            case Json.Object(members): {
                return members.map(fn(m: Member) -> Int {
                    return m.value.total();
                }).sum();
            }

            default: {
                return 0;
            }
        }
    }
}

// A value reached by a path of keys, or why it could not be.
fn path(root: Json, keys: [String]) -> Lookup {
    let current = root;

    for key in keys {
        match current.get(key) {
            case Lookup.Found(value): {
                current = value;
            }

            case Lookup.NoSuchKey(missing): {
                return Lookup.NoSuchKey(missing);
            }

            case Lookup.NotAnObject: {
                return Lookup.NotAnObject;
            }
        }
    }

    return Lookup.Found(current);
}

fn firstNumber(j: Json) -> Option<Int> {
    match j {
        case Json.Number(n): {
            return Option.Some(n);
        }

        case Json.Array(items): {
            for item in items {
                match firstNumber(item) {
                    case Option.Some(n): {
                        return Option.Some(n);
                    }

                    case Option.None: {}
                }
            }

            return Option.None;
        }

        default: {
            return Option.None;
        }
    }
}

fn main() -> Int {
    let doc = Json.Object([
        member("name", Json.String("qoqi")),
        member("version", Json.Number(4)),
        member("stable", Json.Bool(false)),
        member("license", Json.Null),
        member("tags", Json.Array([Json.String("vm"), Json.String("typed")])),
        member(
            "build",
            Json.Object([
                member("heap_mb", Json.Number(256)),
                member("flags", Json.Array([])),
                member(
                    "matrix",
                    Json.Array([
                        Json.Array([Json.Number(1), Json.Number(2)]),
                        Json.Array([Json.Number(3)]),
                    ]),
                ),
            ]),
        ),
    ]);

    println(doc.compact());
    println(doc.pretty(0));
    println(doc.kind(), doc.count(), doc.total());

    for keys in [
        ["name"],
        ["build", "heap_mb"],
        ["build", "matrix"],
        ["build", "debug"],
        ["name", "length"],
        [],
    ] {
        let found = path(doc, keys);

        match found {
            case Lookup.Found(Json.String(text)): {
                println(keys, "-> the text", text);
            }

            case Lookup.Found(Json.Number(n)): {
                println(keys, "-> the number", n);
            }

            case Lookup.Found(other): {
                println(keys, "-> a value of kind", other.kind(), "holding", other.count());
            }

            case Lookup.NoSuchKey(key): {
                println(keys, "-> no key", key);
            }

            case Lookup.NotAnObject: {
                println(keys, "-> not an object");
            }
        }
    }

    println(
        firstNumber(Json.Array([Json.Null, Json.Array([Json.String("x"), Json.Number(9)])])),
        firstNumber(Json.String("x")),
    );

    println(
        Json.Number(1) == Json.Number(1),
        Json.Number(1) == Json.String("1"),
        Json.Null == Json.Null,
        Json.Bool(true) != Json.Bool(false),
    );

    return 0;
}
