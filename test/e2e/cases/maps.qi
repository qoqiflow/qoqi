// Dictionaries written as literals, and maps whose keys are not texts: a
// seating plan by row and seat, scores by player, counts by an enum.

enum Fruit {
    Apple,
    Pear,
    Plum,
}

struct Player {
    name: String;
    team: String;
}

fn main() -> Int {
    // Texts as keys: a Dict
    let prices = { "apple": 30, "pear": 45 };
    prices["plum"] = 60;
    println(prices, prices["pear"], prices.has("kiwi"), prices.len());

    // Tuples as keys: a Map
    let seats = { (1, 1): "ada", (1, 2): "alan" };
    seats[(2, 1)] = "grace";
    println(seats[(1, 2)], seats[(9, 9)], seats.keys());

    for (seat, name) in seats.entries() {
        println("  row ${seat.0}, seat ${seat.1}: ${name}");
    }

    // An enum as keys, counted
    let basket = [Apple, Pear, Apple, Plum, Apple];
    let counts = map.empty<Fruit, Int>();

    for fruit in basket {
        counts.update(fruit, 0, n -> n + 1);
    }

    println(counts, counts[Apple]);

    // Structs as keys: equal structs are the same key
    let scores: Map<Player, Int> = {};
    scores[Player { name: "ada", team: "red" }] = 10;
    scores.update(Player { name: "ada", team: "red" }, 0, n -> n + 5);
    scores[Player { name: "ada", team: "blue" }] = 1;
    println(scores.len(), scores[Player { name: "ada", team: "red" }]);

    // Taking keys out, comparing, copying
    let copy = seats.copy();
    println(seats.remove((1, 1)), seats.remove((1, 1)), seats.len(), copy.len());
    println({ 1: "one" } == { 1: "one" }, seats == copy);

    // Sets of any items
    let met = set.of([Player { name: "ada", team: "red" }, Player { name: "ada", team: "red" }]);
    println(met.len(), set.of([3, 1, 3, 2]), set.of(basket).has(Plum));
    return 0;
}
