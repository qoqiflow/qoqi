// Traits: values of several structs behind one trait, called in a loop.

trait Shape {
    fn area() -> Int;
    fn perimeter() -> Int;
    fn name() -> String;
}

struct Rect {
    width: Int;
    height: Int;
}

struct Square {
    side: Int;
}

struct Triangle {
    a: Int;
    b: Int;
    c: Int;
    height: Int;
}

impl Shape for Rect {
    fn area() -> Int {
        return self.width * self.height;
    }

    fn perimeter() -> Int {
        return 2 * (self.width + self.height);
    }

    fn name() -> String {
        return "rect";
    }
}

impl Shape for Square {
    fn area() -> Int {
        return self.side * self.side;
    }

    fn perimeter() -> Int {
        return 4 * self.side;
    }

    fn name() -> String {
        return "square";
    }
}

impl Shape for Triangle {
    fn area() -> Int {
        return self.a * self.height / 2;
    }

    fn perimeter() -> Int {
        return self.a + self.b + self.c;
    }

    fn name() -> String {
        return "triangle";
    }
}

fn make(i: Int) -> Shape {
    if i % 3 == 0 {
        return Rect { width: i % 17 + 1, height: i % 5 + 1 };
    }

    if i % 3 == 1 {
        return Square { side: i % 11 + 1 };
    }

    return Triangle { a: i % 13 + 3, b: i % 7 + 3, c: i % 5 + 3, height: i % 9 + 1 };
}

fn main() -> Int {
    let shapes: [Shape] = [];

    for i in 0..3000 {
        shapes.push(make(i));
    }

    let area = 0;
    let perimeter = 0;
    let squares = 0;

    for round in 0..40 {
        for shape in shapes {
            area = (area + shape.area()) % 1000003;
            perimeter = (perimeter + shape.perimeter()) % 1000003;

            if shape.name() == "square" {
                squares += 1;
            }
        }
    }

    println(shapes.len(), area, perimeter, squares);
    return 0;
}
