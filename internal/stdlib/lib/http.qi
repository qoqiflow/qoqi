// The web: asking servers for things, and being one.
//
// Asking:
//
//     match http.get("https://example.com/api/users/1") {
//         case Ok(response): { println(response.status, response.body); }
//         case Err(error): { println(error.describe()); }
//     }
//
// A server that answers "not found" has answered: that is a Response,
// with status 404. An Error is for when there was no answer at all.
//
// Answering:
//
//     let app = http.router();
//     app.get("/hello/:name", fn(request: Request) -> Response {
//         return http.text("hello, ${request.params.get("name") ?? "you"}");
//     });
//     http.serve(8080, app.handler()).expect("a free port");
//
// serve answers for as long as the program runs. A server to be stopped is
// listened on, answered in a task, and closed:
//
//     let server = http.listen(8080).expect("a free port");
//     let serving = task.run(fn() { server.handleAll(app.handler()); });
//     ...
//     server.close();      // once the requests in progress are answered
//     wait serving;

import std.result;
import std.result.{Result};
import std.dict;
import std.dict.{Dict};
import std.json;
import std.json.{Json};
import std.strings;
import std.encoding;
import std.arrays;
import std.math;
import std.io;
import std.fs;
import std.path;
import std.task;
import std.ops.{Show};

pub enum Method { Get, Post, Put, Patch, Delete, Head, Options }

impl Method {
    pub fn name() -> String {
        return match self {
            case Method.Get: "GET";
            case Method.Post: "POST";
            case Method.Put: "PUT";
            case Method.Patch: "PATCH";
            case Method.Delete: "DELETE";
            case Method.Head: "HEAD";
            case Method.Options: "OPTIONS";
        };
    }
}

// The method a name stands for, or null: methodOf("post") is Method.Post.
pub fn methodOf(name: String) -> Method? {
    let all = [
        Method.Get,
        Method.Post,
        Method.Put,
        Method.Patch,
        Method.Delete,
        Method.Head,
        Method.Options,
    ];

    let wanted = name.upper();
    return all.find(method -> method.name() == wanted);
}

// Why there was no answer.
pub enum ErrorKind {
    Timeout,      // nothing came back in time
    Refused,      // nothing is listening there
    UnknownHost,  // no machine has that name
    BadUrl,       // the address is not one
    InUse,        // for a server: the port is taken
    Other,
}

pub struct Error {
    kind: ErrorKind;
    url: String;                   // what was asked, or for a server "port 8080"
    message: String;
    priv listening: Bool = false;  // the error of a server that could not listen
}

impl Error {
    // What went wrong, in a sentence: "no answer from https://example.com:
    // ...", or for a server "cannot listen on port 8080: the port is taken".
    pub fn describe() -> String {
        if self.listening {
            return "cannot listen on ${self.url}: ${self.message}";
        }

        return "no answer from ${self.url}: ${self.message}";
    }
}

// An error prints as what describe says.
impl Show for Error {
    fn show() -> String {
        return self.describe();
    }
}

// What a server answers, and what a server of your own answers with.
pub struct Response {
    status: Int;            // 200 is fine, 404 not found, 500 the server failed
    headers: Dict<String>;  // names in lower case: "content-type"
    body: String;
}

impl Response {
    // Whether the status says it went well: 200 to 299.
    pub fn ok() -> Bool {
        return self.status >= 200 && self.status < 300;
    }

    // The value of a header, whatever the case of its name, or null.
    pub fn header(name: String) -> String? {
        return self.headers.get(name.lower());
    }

    // The body read as JSON.
    pub fn json() -> Result<Json, json.ParseError> {
        return json.parse(self.body);
    }

    // The same answer with one more header. Returns it, to chain.
    pub fn with(name: String, value: String) -> Response {
        self.headers.set(name.lower(), value);
        return self;
    }
}

// --- Asking ---

// A request about to be sent, built a part at a time:
//
//     http.to(Method.Post, url).header("Authorization", token).json(document).send()
pub struct Call {
    method: Method;
    url: String;
    headers: Dict<String>;
    body: String;
    timeout: Int;  // milliseconds to wait for the answer
}

pub fn to(method: Method, url: String) -> Call {
    return Call {
        method: method,
        url: url,
        headers: dict.empty<String>(),
        body: "",
        timeout: 30000,
    };
}

impl Call {
    pub fn header(name: String, value: String) -> Call {
        self.headers.set(name, value);
        return self;
    }

    // A value in the query of the address, encoded as it must be:
    // .query("q", "a b") adds ?q=a+b.
    pub fn query(name: String, value: String) -> Call {
        let joint = "?";

        if self.url.contains("?") {
            joint = "&";
        }

        self.url = self.url + joint + encoding.toUrl(name) + "=" + encoding.toUrl(value);
        return self;
    }

    pub fn body(text: String) -> Call {
        self.body = text;
        return self;
    }

    // A document as the body, announced as JSON.
    pub fn json(document: Json) -> Call {
        self.body = document.stringify();
        return self.header("Content-Type", "application/json");
    }

    pub fn timeout(milliseconds: Int) -> Call {
        self.timeout = milliseconds;
        return self;
    }

    pub fn send() -> Result<Response, Error> {
        let parts = exchange(
            self.method.name(),
            self.url,
            pairs(self.headers),
            self.body,
            self.timeout,
        );

        if parts == null {
            return Err(noAnswer(self.url));
        }

        // The status, the body, then the headers
        return Ok(Response {
            status: parts[0].parseInt() ?? 0,
            headers: paired(parts, 2),
            body: parts[1],
        });
    }
}

pub fn get(url: String) -> Result<Response, Error> {
    return to(Method.Get, url).send();
}

// Sends a text. `contentType` says what it is: "text/plain", "application/json".
pub fn post(url: String, body: String, contentType: String) -> Result<Response, Error> {
    return to(Method.Post, url).header("Content-Type", contentType).body(body).send();
}

pub fn postJson(url: String, document: Json) -> Result<Response, Error> {
    return to(Method.Post, url).json(document).send();
}

// --- Answering ---

// What someone asked a server.
pub struct Request {
    method: Method;
    path: String;           // "/users/7"
    query: Dict<String>;    // what follows the ?: ?page=2 gives "page" -> "2"; a name given twice keeps its last value
    headers: Dict<String>;  // names in lower case
    body: String;
    params: Dict<String>;   // the parts of the path a route names: /users/:id
    sender: String;         // the address it came from
    priv id: Int = 0;       // which request of its server it is, for the answer
}

impl Request {
    pub fn header(name: String) -> String? {
        return self.headers.get(name.lower());
    }

    // The body read as JSON.
    pub fn json() -> Result<Json, json.ParseError> {
        return json.parse(self.body);
    }
}

// A request as a server hands it over, for testing routes without one:
// router.answer(http.request(Method.Get, "/notes?tag=work")). The address
// is a path, with a query or not; the request has no headers, and its
// sender is "test".
pub fn request(method: Method, address: String, body: String = "") -> Request {
    let (path, query) = address.cut("?") ?? (address, "");

    return Request {
        method: method,
        path: path,
        query: queryOf(query),
        headers: dict.empty<String>(),
        body: body,
        params: dict.empty<String>(),
        sender: "test",
    };
}

// An answer with a status and a text.
pub fn respond(status: Int, body: String) -> Response {
    let headers = dict.empty<String>();
    headers.set("content-type", "text/plain; charset=utf-8");
    return Response { status: status, headers: headers, body: body };
}

// 200 with a text.
pub fn text(body: String) -> Response {
    return respond(200, body);
}

// 200 with a page.
pub fn html(body: String) -> Response {
    return respond(200, body).with("Content-Type", "text/html; charset=utf-8");
}

// A document, with the status that goes with it.
pub fn sendJson(status: Int, document: Json) -> Response {
    return respond(status, document.stringify()).with("Content-Type", "application/json");
}

pub fn notFound() -> Response {
    return respond(404, "not found");
}

// A handler that serves the files of a folder: the part of the address a
// route's * takes names the file.
//
//     app.get("/static/*", http.files("public"));     // /static/css/site.css is public/css/site.css
//
// A folder gives its index.html. What is not there is 404, and so is an
// address that tries to leave the folder with "..". The content type
// comes from the extension.
pub fn files(folder: String) -> fn(Request) -> Response {
    return fn(request: Request) -> Response {
        let parts = (request.params.get("rest") ?? request.path)
            .split("/")
            .filter(part -> part != "" && part != ".");

        if parts.contains("..") || parts.any(part -> part.contains("\\")) {
            return notFound();
        }

        let wanted = path.join([folder].concat(parts));

        if fs.isDir(wanted) {
            wanted = path.inside(wanted, "index.html");
        }

        return match io.readFile(wanted) {
            case Ok(content): respond(200, content).with("Content-Type", contentType(wanted));
            case Err(_): notFound();
        };
    };
}

// Sends the browser to another address.
pub fn redirect(to: String) -> Response {
    return respond(302, "").with("Location", to);
}

// A server that is listening.
pub struct Server {
    priv id: Int;
    port: Int;
    host: String;        // the IP it listens on: "127.0.0.1", "0.0.0.0", "::"
    priv last: Int = 0;  // the request `next` gave last
}

// Starts listening on a port of this machine. Port 0 lets the system
// choose a free one: server.port says which.
//
// The host is the address listened on, an IP or a name. The default,
// 127.0.0.1, is this machine only. "0.0.0.0" is every interface, "::"
// every interface of IPv6: the server can then be reached from other
// machines and from containers, by anyone who can reach this one, so
// what it answers must be fit for them. A host that is not one is a
// BadUrl error, a name no machine has an UnknownHost.
pub fn listen(port: Int, host: String = "127.0.0.1") -> Result<Server, Error> {
    let opened = open(port, host);

    if opened == null {
        let failed = noAnswer("port ${port}");

        if host != "127.0.0.1" {
            failed.url = "port ${port} of ${host}";
        }

        failed.listening = true;
        return Err(failed);
    }

    return Ok(Server {
        id: opened[0].parseInt() ?? 0,
        port: opened[1].parseInt() ?? 0,
        host: opened[2],
    });
}

impl Server {
    // Waits for the next request. Null once the server is closed.
    pub fn next() -> Request? {
        return self.nextWithin(0);
    }

    // The same, giving up after that many milliseconds: null if none came
    // by then, or the server is closed. 0 waits for as long as it takes.
    pub fn nextWithin(milliseconds: Int) -> Request? {
        // Its number, the method, the path, the query, the body, the
        // sender, then the headers
        let parts = accept(self.id, milliseconds)?;
        self.last = parts[0].parseInt() ?? 0;

        return Request {
            method: methodOf(parts[1]) ?? Method.Get,
            path: parts[2],
            query: queryOf(parts[3]),
            headers: paired(parts, 6),
            body: parts[4],
            params: dict.empty<String>(),
            sender: parts[5],
            id: self.last,
        };
    }

    // Answers the request `next` gave last. Each request is answered once.
    pub fn reply(response: Response) {
        respondTo(self.id, self.last, response.status, pairs(response.headers), response.body);
    }

    // Answers a request `next` gave, whichever it was: for a server that
    // takes the next request before it has answered the one before, each
    // being worked on in a task of its own.
    pub fn answer(request: Request, response: Response) {
        respondTo(self.id, request.id, response.status, pairs(response.headers), response.body);
    }

    // Answers that many requests with what a function makes of each, then
    // returns. A handler that stops, by a panic or any other failure, does
    // not stop the server: its request is answered with status 500.
    pub fn handle(count: Int, handler: fn(Request) -> Response) {
        for served in 0..count {
            let request = self.next()?;
            self.reply(answerOf(request, handler));
        }
    }

    // Answers every request until the server is closed, each in a task
    // of its own. Start it in a task to do something else meanwhile, and
    // close the server to stop it:
    //
    //     let serving = task.run(fn() { server.handleAll(app.handler()); });
    //     ...
    //     server.close();
    pub fn handleAll(handler: fn(Request) -> Response) {
        while true {
            let request = self.next()?;
            answerApart(self, request, handler);
        }
    }

    // Stops taking requests, waits for those in progress to be answered,
    // for ten seconds at most, then closes. A request that comes in
    // meanwhile, or is still unanswered after that, is answered 503.
    pub fn close() {
        shut(self.id);
    }
}

// Answers one request in a task of its own.
fn answerApart(server: Server, request: Request, handler: fn(Request) -> Response) {
    task.run(fn() {
        server.answer(request, answerOf(request, handler));
    });
}

// What a handler makes of a request, or status 500 if it stops.
fn answerOf(request: Request, handler: fn(Request) -> Response) -> Response {
    match result.attempt(fn() -> Response {
        return handler(request);
    }) {
        case Ok(response): {
            return response;
        }

        case Err(failure): {
            io.printError("${request.method.name()} ${request.path} failed: ${failure.describe()}\n");
            return respond(500, "the server failed");
        }
    }
}

// Listens on a port and answers every request with what a function makes
// of it, for as long as the program runs. Each request is answered in a
// task of its own: one that waits, for a file or for another server, does
// not keep the others waiting. It only returns if the port cannot be
// listened on: nothing else holds the server, so nothing can close it. A
// server to be stopped is made with listen, answered with handleAll in a
// task, and closed. The host is listen's: this machine only by default.
pub fn serve(
    port: Int,
    handler: fn(Request) -> Response,
    host: String = "127.0.0.1",
) -> Result<Server, Error> {
    return listen(port, host).map(fn(server: Server) -> Server {
        server.handleAll(handler);
        return server;
    });
}

// --- Routes ---

struct Route {
    method: Method;
    parts: [String];
    handler: fn(Request) -> Response;
}

// Chooses what answers a request from its method and its path.
//
//     let app = http.router();
//     app.get("/", home);
//     app.get("/users/:id", showUser);        // request.params.get("id")
//     app.post("/users", createUser);
//     http.serve(8080, app.handler());
//
// Routes are tried in the order they were added. A path nobody takes is
// answered with 404, and a path taken only for other methods with 405. A
// HEAD request that no route takes for HEAD is answered by the GET route
// of its path, with that route's status and headers and no body.
pub struct Router {
    priv routes: [Route];
}

pub fn router() -> Router {
    return Router { routes: [] };
}

impl Router {
    // Adds a route. In the path, a part starting with a colon takes
    // whatever is there and gives it that name in request.params; a last
    // part that is * takes all that is left, under the name "rest".
    pub fn on(method: Method, path: String, handler: fn(Request) -> Response) -> Router {
        self.routes.push(Route { method: method, parts: partsOf(path), handler: handler });
        return self;
    }

    pub fn get(path: String, handler: fn(Request) -> Response) -> Router {
        return self.on(Method.Get, path, handler);
    }

    pub fn post(path: String, handler: fn(Request) -> Response) -> Router {
        return self.on(Method.Post, path, handler);
    }

    pub fn put(path: String, handler: fn(Request) -> Response) -> Router {
        return self.on(Method.Put, path, handler);
    }

    pub fn patch(path: String, handler: fn(Request) -> Response) -> Router {
        return self.on(Method.Patch, path, handler);
    }

    pub fn delete(path: String, handler: fn(Request) -> Response) -> Router {
        return self.on(Method.Delete, path, handler);
    }

    // The answer to a request.
    pub fn answer(request: Request) -> Response {
        let parts = partsOf(request.path);
        let pathIsKnown = false;
        let asGet: Route? = null;
        let asGetParams = dict.empty<String>();

        for route in self.routes {
            let params = fit(route.parts, parts);

            if params == null {
                continue;
            }

            pathIsKnown = true;

            if route.method == request.method {
                request.params = params;
                let handler = route.handler;
                return handler(request);
            }

            if request.method == Method.Head && route.method == Method.Get && asGet == null {
                asGet = route;
                asGetParams = params;
            }
        }

        if asGet != null {
            request.params = asGetParams;
            let handler = asGet.handler;
            let full = handler(request);
            return Response { status: full.status, headers: full.headers, body: "" };
        }

        if pathIsKnown {
            return respond(405, "method not allowed");
        }

        return notFound();
    }

    // The router as one function, for serve and handle.
    pub fn handler() -> fn(Request) -> Response {
        return fn(request: Request) -> Response {
            return self.answer(request);
        };
    }
}

// What the named parts of a route take in a path, or null if the path is
// not one of that route.
fn fit(route: [String], path: [String]) -> Dict<String>? {
    let params = dict.empty<String>();

    for i, part in route {
        if part == "*" && i == route.len() - 1 {
            params.set("rest", path.slice(i.min(path.len()), path.len()).join("/"));

            return params;
        }

        if i >= path.len() {
            return null;
        }

        if part.startsWith(":") {
            params.set(part.from(1), path[i]);
        } else if part != path[i] {
            return null;
        }
    }

    if path.len() != route.len() {
        return null;
    }

    return params;
}

fn partsOf(path: String) -> [String] {
    let named = fn(part: String) -> Bool {
        return part != "";
    };

    return path.split("/").filter(named);
}

// "a=1&b=x+y" as a dictionary, the values decoded. A name given twice
// keeps its last value: url.queryOf keeps them all.
pub fn queryOf(query: String) -> Dict<String> {
    let out = dict.empty<String>();

    for pair in query.split("&") {
        if pair == "" {
            continue;
        }

        let (name, value) = pair.cut("=") ?? (pair, "");
        out.set(encoding.fromUrl(name) ?? name, encoding.fromUrl(value) ?? value);
    }

    return out;
}

// A dictionary as name, value, name, value.
fn pairs(headers: Dict<String>) -> [String] {
    let out: [String] = [];

    headers.each(fn(name: String, value: String) {
        out.push(name);
        out.push(value);
    });

    return out;
}

// The other way round, from a position on.
fn paired(parts: [String], from: Int) -> Dict<String> {
    let out = dict.empty<String>();
    let i = from;

    while i + 1 < parts.len() {
        out.set(parts[i], parts[i + 1]);
        i += 2;
    }

    return out;
}

fn noAnswer(url: String) -> Error {
    // The kind, then the message
    let parts = problem();
    return Error { kind: kindOf(parts[0]), url: url, message: parts[1] };
}

fn kindOf(name: String) -> ErrorKind {
    return match name {
        case "timeout": ErrorKind.Timeout;
        case "refused": ErrorKind.Refused;
        case "unknown host": ErrorKind.UnknownHost;
        case "bad url": ErrorKind.BadUrl;
        case "in use": ErrorKind.InUse;
        default: ErrorKind.Other;
    };
}

extern fn exchange(
    method: String,
    url: String,
    headers: [String],
    body: String,
    timeout: Int,
) -> [String]?;

extern fn open(port: Int, host: String) -> [String]?;
extern fn accept(server: Int, timeout: Int) -> [String]?;
extern fn respondTo(server: Int, request: Int, status: Int, headers: [String], body: String);
extern fn shut(server: Int);
extern fn contentType(name: String) -> String;
extern fn problem() -> [String];
